            "state": "translated",
            "value": "Este iPhone no admite Apple Intelligence."
          }
        }
      }
    },
    "Questo non è il QR di Argo: su computer apri Incontri › Collega iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht der QR-Code von Argo: Öffne am Computer Termine › iPhone verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not Argo's QR code: on the computer open Meetings › Connect iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es el QR de Argo: en el ordenador abre Reuniones › Conectar iPhone."
          }
        }
      }
    },
