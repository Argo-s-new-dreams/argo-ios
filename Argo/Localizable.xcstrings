      }
    },
    "Trascrizione, foto e relazione vengono cancellate da questo iPhone. Se non l'hai inviato ad Argo sul computer, non si possono recuperare.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript, Fotos und Bericht werden von diesem iPhone gelöscht. Wenn du ihn nicht an Argo auf dem Computer gesendet hast, lassen sie sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript, photos and report are deleted from this iPhone. If you haven't sent it to Argo on your computer, they can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción, las fotos y el informe se borran de este iPhone. Si no la has enviado a Argo en el ordenador, no se pueden recuperar."
          }
        }
      }
    },
    "Tutto aggiornato.": {
