    "Argo": {
      "shouldTranslate": false
    },
    "Argo non ti riconoscerà più negli incontri finché non registri di nuovo la tua voce.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo erkennt dich in Terminen nicht mehr, bis du deine Stimme erneut aufnimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo will no longer recognise you in meetings until you record your voice again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo ya no te reconocerá en las reuniones hasta que vuelvas a grabar tu voz."
          }
        }
      }
    },
    "Argo riconosce la tua voce negli incontri e la chiama con questo nome, separandola da quelle degli interlocutori. L'impronta vocale è un dato biometrico: resta solo su questo iPhone e non viene mai esportata.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo erkennt deine Stimme in Terminen und nennt sie mit diesem Namen, getrennt von denen deiner Gesprächspartner. Der Stimmabdruck ist ein biometrisches Datum: Er bleibt nur auf diesem iPhone und wird nie exportiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo recognises your voice in meetings and calls it by this name, separating it from the people you talk to. The voiceprint is biometric data: it stays only on this iPhone and is never exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo reconoce tu voz en las reuniones y la llama con este nombre, separándola de la de tus interlocutores. La huella vocal es un dato biométrico: se queda solo en este iPhone y nunca se exporta."
          }
        }
      }
    },
    "Argo sul computer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo auf dem Computer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo on your computer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo en el ordenador"
          }
        }
      }
    },
    "Argo sul computer ha risposto con errore %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo auf dem Computer hat mit Fehler %lld geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo on your computer replied with error %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo en el ordenador ha respondido con el error %lld."
          }
        }
      }
    },
    "Argo sul computer non raggiungibile: deve essere aperto e sulla stessa rete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo auf dem Computer ist nicht erreichbar: Es muss geöffnet und im selben Netz sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo on your computer can't be reached: it must be open and on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo en el ordenador no está accesible: debe estar abierto y en la misma red."
          }
        }
      }
    },
    "Argo sul computer: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argo auf dem Computer: %@"
