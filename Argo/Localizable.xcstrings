    "Italiano, English, Español o Deutsch: si sceglie nelle Impostazioni di iOS › Argo › Lingua. La lingua della riunione resta una scelta a parte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Italiano, English, Español oder Deutsch: Wähle sie in den iOS-Einstellungen › Argo › Sprache. Die Sprache des Termins ist eine eigene Wahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Italiano, English, Español or Deutsch: choose it in iOS Settings › Argo › Language. The meeting language is a separate choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Italiano, English, Español o Deutsch: se elige en Ajustes de iOS › Argo › Idioma. El idioma de la reunión es una opción aparte."
          }
        }
      }
    },
    "L'anagrafe è vuota o contiene impronte non compatibili.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verzeichnis ist leer oder enthält inkompatible Stimmabdrücke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The registry is empty or contains incompatible voiceprints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro está vacío o contiene huellas no compatibles."
          }
        }
      }
    },
    "L'audio viene cancellato subito: resta solo un'impronta numerica, salvata su questo iPhone e mai esportata.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio wird sofort gelöscht: Es bleibt nur ein numerischer Abdruck, gespeichert auf diesem iPhone und nie exportiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio is deleted immediately: only a numeric voiceprint remains, saved on this iPhone and never exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se borra enseguida: solo queda una huella numérica, guardada en este iPhone y nunca exportada."
          }
        }
      }
    },
    "La lingua %@ non è supportata dalla trascrizione sul dispositivo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache %@ wird von der Transkription auf dem Gerät nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language %@ is not supported by on-device transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma %@ no es compatible con la transcripción en el dispositivo."
          }
        }
      }
    },
    "La mia voce": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Stimme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi voz"
          }
        }
      }
    },
    "La trascrizione avviene sempre sull'iPhone. Il modello della lingua viene scaricato da Apple la prima volta.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription findet immer auf dem iPhone statt. Apple lädt das Sprachmodell beim ersten Mal herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription always happens on the iPhone. Apple downloads the language model the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción siempre se hace en el iPhone. Apple descarga el modelo del idioma la primera vez."
          }
        }
      }
    },
    "Leggi ad alta voce, con il tuo tono normale, in un posto tranquillo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies laut, in deinem normalen Ton, an einem ruhigen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read aloud, in your normal tone, in a quiet place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee en voz alta, con tu tono normal, en un lugar tranquilo."
          }
        }
      }
    },
    "Leggo la foto %lld di %lld…": {
