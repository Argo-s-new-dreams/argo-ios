    "Elaborazione interrotta prima della fine. L'audio è ancora sul telefono: premi «Trascrivi e crea la relazione» per riprendere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung wurde vor dem Ende unterbrochen. Das Audio ist noch auf dem Telefon: Tippe auf «Transkribieren und Bericht erstellen», um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing stopped before the end. The audio is still on the phone: tap «Transcribe and create the report» to resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento se interrumpió antes del final. El audio sigue en el teléfono: pulsa «Transcribir y crear el informe» para continuar."
          }
        }
      }
    },
