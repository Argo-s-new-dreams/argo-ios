          }
        }
      }
    },
    "Mac e iPhone sulla stessa Wi-Fi. Sul Mac, Ollama deve accettare connessioni dalla rete locale. La trascrizione viaggia solo tra i tuoi dispositivi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac und iPhone im selben WLAN. Auf dem Mac muss Ollama Verbindungen aus dem lokalen Netz annehmen. Das Transkript reist nur zwischen deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac and iPhone on the same Wi-Fi. On the Mac, Ollama must accept connections from the local network. The transcript only travels between your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac y iPhone en la misma wifi. En el Mac, Ollama debe aceptar conexiones de la red local. La transcripción solo viaja entre tus dispositivos."
          }
        }
      }
    },
    "Mac raggiunto · %lld modelli installati": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac erreicht · %lld Modelle installiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac reached · %lld models installed"
          }
        },
        "es": {
