        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribo el acta con Apple Intelligence…"
          }
        }
      }
    },
    "Se elimini o reinstalli l'app si perdono: prima inviali ad Argo sul computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die App löschst oder neu installierst, gehen sie verloren: Sende sie vorher an Argo auf dem Computer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you delete or reinstall the app they are lost: send them to Argo on your computer first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliminas o reinstalas la app se pierden: antes envíalas a Argo en el ordenador."
          }
        }
      }
    },
    "Serve il permesso di riconoscimento vocale: lo trovi in Impostazioni › Privacy › Riconoscimento vocale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung zur Spracherkennung wird benötigt: Du findest sie unter Einstellungen › Datenschutz › Spracherkennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition permission is needed: you can find it in Settings › Privacy › Speech Recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta el permiso de reconocimiento de voz: lo encuentras en Ajustes › Privacidad › Reconocimiento de voz."
          }
        }
      }
    },
    "Serve l'accesso al microfono.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf das Mikrofon wird benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta acceso al micrófono."
          }
        }
      }
    },
    "Serve l'accesso al microfono: lo trovi in Impostazioni › Privacy › Microfono.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf das Mikrofon wird benötigt: Du findest ihn unter Einstellungen › Datenschutz › Mikrofon."
          }
        },
        "en": {
