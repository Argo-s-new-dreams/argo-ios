    },
    "Tocca «Registra» qui sotto: durante l'incontro puoi scattare foto a biglietti da visita e documenti. Trascrizione, voci e testo delle foto vengono elaborati sul tuo iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf «Aufnehmen»: Während des Termins kannst du Visitenkarten und Dokumente fotografieren. Transkript, Stimmen und Fototext werden auf deinem iPhone verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap «Record» below: during the meeting you can take photos of business cards and documents. Transcript, voices and photo text are processed on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Grabar» aquí abajo: durante la reunión puedes hacer fotos de tarjetas de visita y documentos. La transcripción, las voces y el texto de las fotos se procesan en tu iPhone."
          }
        }
      }
    },
    "Trascrivi e crea la relazione": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkribieren und Bericht erstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe and create the report"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribir y crear el informe"
          }
        }
      }
    },
    "Trascrivo sul dispositivo…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription auf dem Gerät…"
          }
        },
        "en": {
