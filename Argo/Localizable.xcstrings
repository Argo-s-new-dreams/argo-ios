    },
    "Relazione interrotta prima della fine. Premi «Crea la relazione» per riprendere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bericht vor dem Ende unterbrochen. Tippe auf «Bericht erstellen», um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report stopped before the end. Tap «Create the report» to resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe interrumpido antes del final. Pulsa «Crear el informe» para continuar."
          }
        }
      }
    },
