    "Registrazione troppo corta: servono almeno 10 secondi di parlato.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme zu kurz: Mindestens 10 Sekunden Sprache sind nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording too short: at least 10 seconds of speech are needed."
          }
        },
        "es": {
