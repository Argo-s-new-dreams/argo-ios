    "Puoi tornare all'elenco: Argo continua. Tieni l'app aperta finché finisce: lo schermo resta acceso da solo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst zur Liste zurückkehren: Argo arbeitet weiter. Lass die App offen, bis sie fertig ist: Der Bildschirm bleibt von selbst an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can go back to the list: Argo keeps going. Keep the app open until it finishes: the screen stays on by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a la lista: Argo continúa. Mantén la app abierta hasta que termine: la pantalla se queda encendida sola."
          }
        }
      }
    },
    "Questo iPhone non supporta Apple Intelligence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone unterstützt Apple Intelligence nicht."
          }
        },
        "en": {
