    "Come la modalità Live di Argo sul Mac: resta solo il testo, nessun archivio audio sul telefono.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie der Live-Modus von Argo am Mac: Es bleibt nur der Text, kein Audioarchiv auf dem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
