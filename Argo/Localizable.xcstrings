    "Nessun computer collegato.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Computer verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No computer connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún ordenador conectado."
          }
        }
      }
    },
    "Nessun incontro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Termine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meetings yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna reunión"
          }
        }
      }
    },
    "Nessuno, solo trascrizione": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner, nur Transkript"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None, transcript only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno, solo transcripción"
          }
        }
      }
    },
    "Non ho riconosciuto la tua voce in questo incontro: puoi dare i nomi a mano in Partecipanti.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe deine Stimme in diesem Termin nicht erkannt: Du kannst die Namen unter Teilnehmer von Hand vergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't recognise your voice in this meeting: you can name the voices by hand in Participants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he reconocido tu voz en esta reunión: puedes poner los nombres a mano en Participantes."
          }
        }
      }
    },
    "Non ho trovato parlato nella registrazione.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe in der Aufnahme keine Sprache gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I found no speech in the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he encontrado voz en la grabación."
          }
        }
      }
    },
    "Non raggiungo Argo sul computer: deve essere aperto e sulla stessa rete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich erreiche Argo auf dem Computer nicht: Es muss geöffnet und im selben Netz sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't reach Argo on your computer: it must be open and on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llego a Argo en el ordenador: debe estar abierto y en la misma red."
          }
        }
      }
    },
    "Non raggiungo il Mac. Controlla che sia acceso, sulla stessa Wi-Fi e che Ollama accetti connessioni dalla rete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich erreiche den Mac nicht. Prüfe, ob er eingeschaltet und im selben WLAN ist und ob Ollama Netzwerkverbindungen annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't reach the Mac. Check that it is on, on the same Wi-Fi and that Ollama accepts network connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llego al Mac. Comprueba que esté encendido, en la misma wifi y que Ollama acepte conexiones de la red."
          }
        }
      }
    },
    "Non riesco a salvare la foto.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann das Foto nicht speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't save the photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo guardar la foto."
          }
        }
      }
    },
    "Non riesco ad avviare la registrazione.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann die Aufnahme nicht starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't start the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo iniciar la grabación."
          }
        }
      }
    },
    "Non sono riuscito a calcolare l'impronta della voce. Riprova in un posto più tranquillo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte den Stimmabdruck nicht berechnen. Versuche es an einem ruhigeren Ort erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't compute the voiceprint. Try again in a quieter place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido calcular la huella de la voz. Vuelve a intentarlo en un lugar más tranquilo."
          }
        }
      }
    },
    "OK": {
      "shouldTranslate": false
    },
    "Pacchetto (AirDrop, File…)": {
      "localizations": {
        "de": {
