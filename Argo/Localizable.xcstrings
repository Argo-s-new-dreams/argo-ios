{
  "sourceLanguage": "it",
  "strings": {
    " Per avere il verbale, collega il tuo Mac con Ollama in Impostazioni › Verbale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Für das Protokoll verbinde deinen Mac mit Ollama unter Einstellungen › Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " To get the minutes, connect your Mac with Ollama in Settings › Minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Para tener el acta, conecta tu Mac con Ollama en Ajustes › Acta."
          }
        }
      }
    },
    " Puoi usare il Mac in Impostazioni › Verbale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Du kannst den Mac unter Einstellungen › Protokoll verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " You can use your Mac in Settings › Minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Puedes usar el Mac en Ajustes › Acta."
          }
        }
      }
    },
