    "Parlanti non riconosciuti (%@). La trascrizione c'è comunque.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprecher nicht erkannt (%@). Das Transkript ist trotzdem da."
          }
